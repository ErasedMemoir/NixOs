# HP Laptop 15-fd0xxx
{
  networking.hostName = "hp15";

  # Extra scancodes sent with the brightness and mic mute keys, which come
  # through acpi-video and hp-wmi; silences "Unknown key pressed".
  services.udev.extraHwdb = ''
    evdev:atkbd:dmi:*:svnHP:pnHPLaptop15-fd0xxx:*
     KEYBOARD_KEY_82=unknown
     KEYBOARD_KEY_ab=unknown
  '';

  # The mic mute LED lights only when every control attached to it is off.
  # Keep just the internal microphone, so it follows the default source.
  # Started whenever the sound card appears.
  services.udev.extraRules = ''
    ACTION=="add", SUBSYSTEM=="sound", KERNEL=="controlC0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="mic-mute-led.service"
  '';
  systemd.services.mic-mute-led = {
    serviceConfig.Type = "oneshot";
    script = "echo \"iface=MIXER,name='Capture Switch'\" > /sys/class/sound/ctl-led/mic/card0/detach";
  };

  # Generated by ./install.sh facter
  hardware.facter.reportPath = ./facter.json;

  # Release of the first install, do not change.
  system.stateVersion = "26.05";
}
